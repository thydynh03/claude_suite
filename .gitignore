# build/ holds both output and source. Ignoring the whole directory hid
# build/windows/installer/project.nsi from git, so every release built the
# installer from wails' regenerated default template and shipped without the
# companion CLI tools. Only the outputs are ignored now.
build/bin/
build/ClaudeAgentManager/
build/ClaudeScheduler/
build/ClaudeSuite/
build/windows/installer/tmp/
node_modules
frontend/node_modules
frontend/dist
dist/
agent_manager.db*
*.db
*.db-wal
*.db-shm
*.log
*.html
*.syso
__pycache__/
workspace_config.json
gcp_oauth.json
.env
.env.*
ClaudeSuite_Kanban_Report_*.md

# Per-user state written next to the database (see backend/paths).
ui_config.json
integrations_config.json
anti_accounts.json

# Older builds seeded agent roles next to the binary. The real copies live in
# backend/defaults/roles and are embedded; a root-level one is stale output.
# Leading slash so backend/defaults/roles stays tracked.
/roles/

# Adjudication session state is per-run and per-machine; the catalogue at
# .claude-suite/checks.json is reviewed config and stays tracked.
.claude-suite/session-*/
